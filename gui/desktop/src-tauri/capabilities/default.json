{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Xyst desktop controls are available only to the main window and loopback app; project actions require the live runtime token.",
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-last-session",
    "allow-set-last-session",
    "allow-list-projects",
    "allow-choose-project-folder",
    "allow-create-project",
    "allow-switch-project",
    "allow-remove-recent-project"
  ]
}
