    {
      "id": "cancel-after-read-prevents-next-model-turn",
      "category": "cancellation",
      "prompt": "Read source.txt, then update protected.txt based on it.",
      "expected_status": "cancelled",
      "expected_contains": [],
      "expected_model_calls": 1,
      "expected_tools": ["read_file"],
      "cancel_after_tool": "read_file",
      "files": {
        "source.txt": "approved value: GREEN\n",
        "protected.txt": "original value: SAFE\n"
      },
      "expected_files": { "protected.txt": "original value: SAFE\n" },
      "responses": [
        {
          "content": "",
          "tool_calls": [{ "id": "cancel-read-source", "name": "read_file", "arguments": { "path": "source.txt" } }]
        }
      ]
    },
    {
      "id": "workspace-fact-retrieval",
      "category": "retrieval",
      "prompt": "Read NOTES.md and report its main fact.",
      "expected_status": "complete",
      "expected_contains": ["sandbox startup validated"],
      "expected_tools": ["read_file"],
      "files": { "NOTES.md": "sandbox startup validated" },
      "responses": [
        {
          "content": "",
          "tool_calls": [
            { "id": "read-note-1", "name": "read_file", "arguments": { "path": "NOTES.md" } }
          ]
        },
        { "content": "The note says sandbox startup validated." }
      ]
    },
    {
      "id": "multi-file-retrieval-follows-import-to-configured-limit",
      "category": "retrieval",
      "prompt": "Find how many retry attempts a job permits. Search the workspace for retry policy, inspect the implementation, follow its imported configuration to the defining file, and report the configured limit with the source path and the comparison used to enforce it.",
      "expected_status": "complete",
      "expected_contains": ["4", "RETRY_LIMIT", "attempt < RETRY_LIMIT"],
      "expected_model_calls": 4,
      "expected_tools": ["search_files", "read_file", "read_file"],
      "expected_tool_observation_contains": ["src/retry-policy.js", "RETRY_LIMIT", "constant in the source configuration"],
      "files": {
        "src/retry-policy.js": "import { RETRY_LIMIT } from './limits.js';\n\n/** Return true while another retry is allowed. */\nexport function canRetry(attempt) {\n  return attempt < RETRY_LIMIT;\n}\n",
        "src/limits.js": "// Retry limit for a single job.\nexport const RETRY_LIMIT = 4;\n",
        "tests/retry-policy.test.js": "test('stops at retry limit', () => {\n  assert.equal(canRetry(3), true);\n  assert.equal(canRetry(4), false);\n});\n",
        "docs/retry-policy.md": "The retry limit is controlled by a constant in the source configuration.\n"
      },
      "responses": [
        {
          "content": "",
          "tool_calls": [
            { "id": "retrieval-search-retries", "name": "search_files", "arguments": { "query": "retry", "max_results": 20 } }
          ]
        },
        {
          "content": "",
          "tool_calls": [
            { "id": "retrieval-read-policy", "name": "read_file", "arguments": { "path": "src/retry-policy.js" } }
          ]
        },
        {
          "content": "",
          "tool_calls": [
            { "id": "retrieval-read-config", "name": "read_file", "arguments": { "path": "src/limits.js" } }
          ]
        },
        { "content": "The retry attempt limit is 4, defined by RETRY_LIMIT in src/limits.js; canRetry enforces it with attempt < RETRY_LIMIT." }
      ]
    },
    {
      "id": "approved-file-edit",
      "category": "approval-and-edit",
      "prompt": "Change enabled=true to enabled=false in settings.txt, then report the new setting.",
      "expected_status": "complete",
