      "responses": [
        {
          "content": "",
          "tool_calls": [
            { "id": "approved-edit-1", "name": "edit_file", "arguments": { "path": "settings.txt", "old_string": "enabled=true", "new_string": "enabled=false" } }
          ]
        },
        { "content": "Updated and verified the setting: enabled=false." }
      ]
    },
    {
      "id": "denied-file-edit-preserves-source",
      "category": "approval-denial",
      "prompt": "Change mode=safe to mode=unsafe in settings.txt.",
