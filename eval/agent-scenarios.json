      "prompt": "Return the exact phrase: READY FOR REVIEW",
      "expected_status": "complete",
      "expected_contains": ["READY FOR REVIEW"],
      "input_cost_per_million": 0.2,
      "output_cost_per_million": 0.4,
      "responses": [{
        "content": "READY FOR REVIEW",
        "usage": { "prompt_tokens": 14, "completion_tokens": 4, "total_tokens": 18 }
      }]
    },
    {
      "id": "structured-summary-answer",
      "category": "response-quality",
      "prompt": "Summarize the design decision in one sentence.",
      "expected_status": "complete",
      "expected_contains": ["shared runtime", "Windows and Linux"],
      "responses": [{
        "content": "Use one shared runtime for Windows and Linux clients.",
        "usage": { "prompt_tokens": 22, "completion_tokens": 11, "total_tokens": 33 }
      }]
    },
    {
