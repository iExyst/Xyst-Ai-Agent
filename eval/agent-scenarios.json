      "expected_contains": ["unchanged"],
      "expected_tools": [],
      "expected_tool_denials": 1,
      "files": { "settings.txt": "mode=safe\n" },
      "expected_files": { "settings.txt": "mode=safe\n" },
      "responses": [
        {
          "content": "",
          "tool_calls": [
            { "id": "denied-edit-1", "name": "edit_file", "arguments": { "path": "settings.txt", "old_string": "mode=safe", "new_string": "mode=unsafe" } }
          ]
        },
        { "content": "The edit was denied, and the file is unchanged." }
      ]
    },
    {
      "id": "multi-file-feature-flag-refactor",
      "category": "multi-file-coding",
      "prompt": "Rename the exported switch FEATURE_ENABLED to WORKER_FEATURE_ENABLED in both files. Read and verify both files before finishing.",
      "expected_status": "complete",
      "expected_contains": ["WORKER_FEATURE_ENABLED", "verified in both files"],
      "expected_tools": ["read_file", "read_file", "edit_file", "edit_file", "read_file", "read_file"],
      "approved_tools": ["edit_file"],
      "files": {
        "src/feature.js": "export const FEATURE_ENABLED = true;\n",
        "src/worker.js": "if (FEATURE_ENABLED) startWorker();\n"
      },
      "expected_files": {
        "src/feature.js": "export const WORKER_FEATURE_ENABLED = true;\n",
        "src/worker.js": "if (WORKER_FEATURE_ENABLED) startWorker();\n"
      },
      "responses": [
        {
          "content": "",
          "tool_calls": [
            { "id": "multi-read-feature", "name": "read_file", "arguments": { "path": "src/feature.js" } },
            { "id": "multi-read-worker", "name": "read_file", "arguments": { "path": "src/worker.js" } }
          ]
        },
        {
          "content": "",
          "tool_calls": [
            {
              "id": "multi-edit-feature",
              "name": "edit_file",
              "arguments": {
                "path": "src/feature.js",
                "old_string": "FEATURE_ENABLED",
                "new_string": "WORKER_FEATURE_ENABLED"
              }
            },
            {
              "id": "multi-edit-worker",
              "name": "edit_file",
              "arguments": { "path": "src/worker.js", "old_string": "FEATURE_ENABLED", "new_string": "WORKER_FEATURE_ENABLED" }
            }
          ]
        },
        {
          "content": "",
          "tool_calls": [
            { "id": "multi-verify-feature", "name": "read_file", "arguments": { "path": "src/feature.js" } },
            { "id": "multi-verify-worker", "name": "read_file", "arguments": { "path": "src/worker.js" } }
          ]
        },
        { "content": "WORKER_FEATURE_ENABLED is present and verified in both files." }
      ]
    },
